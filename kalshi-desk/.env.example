# Copy to .env. Keys come from Kalshi > profile picture > Account Settings > API Keys.
# Demo and production keys are separate accounts and separate keys.
KALSHI_ENV=demo

KALSHI_DEMO_KEY_ID=
KALSHI_DEMO_KEY_PATH=keys/kalshi-demo.key

KALSHI_PROD_KEY_ID=
KALSHI_PROD_KEY_PATH=keys/kalshi-prod.key

# live.py refuses to run unless this is exactly true AND the phrase is typed.
LIVE_TRADING=false

# Dollar caps, enforced in paper.py and live.py before any order is sent.
MAX_ORDER_DOLLARS=5
MAX_OPEN_DOLLARS=50

# Fractional Kelly. The backtest swept 0.1 to 1.0; 0.25 is the reporting default.
KELLY_FRACTION=0.25

# Pretend bankroll for the shadow book, which has no account to read one from.
SHADOW_BANKROLL=100
